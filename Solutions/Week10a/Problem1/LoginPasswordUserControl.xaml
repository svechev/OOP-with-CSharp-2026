<UserControl x:Class="Problem1.LoginPasswordUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Problem1"
             mc:Ignorable="d" 
             d:DesignHeight="178.554" d:DesignWidth="539.908">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="19"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="19"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="100,0"></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="19"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Padding" Value="2"></Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="19"></Setter>
            <Setter Property="FontWeight" Value="Bold"></Setter>
            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="PasswordChar" Value="?"></Setter>
            <Setter Property="Padding" Value="2"></Setter>
        </Style>

    </UserControl.Resources>
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!--User name-->
        <Label   Grid.Row="0" Grid.Column="0" Content="User"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserName" Width="350"/>

        <!--Password-->
        <Label       Grid.Row="1" Grid.Column="0" Content="Password"/>
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PwdUser" Width="350"/>

        <!--Buttons-->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="BtnLogin" Content="Login" Click="BtnLogin_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
        </StackPanel>

    </Grid>
</UserControl>
