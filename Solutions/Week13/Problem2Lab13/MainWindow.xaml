<Window x:Class="Problem2Lab13.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Problem2Lab13"
        mc:Ignorable="d"
        Title="MainWindow" Height="270" Width="500" Closing="Window_Closing">
    <StackPanel>
        <TextBox x:Name="TxtClock" Text="00:00:00" VerticalAlignment="Top" HorizontalAlignment="Center"
                 FontWeight="Bold" FontSize="25"></TextBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Margin="10" Width="50" x:Name="btnStart" Content="Start" Click="btnStart_Click"></Button>
            <Button Margin="10" Width="50" x:Name="btnStop" Content="Stop" Click="btnStop_Click"></Button>
        </StackPanel>
    </StackPanel>
</Window>
