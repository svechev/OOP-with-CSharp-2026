<Window x:Class="Problem4Lab3b.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Problem4Lab3b"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="350">
    <Grid>
        <StackPanel Margin="15">
            <!--Question-->
            <Label x:Name="LblQuestion" 
                   FontSize="25" 
                   HorizontalAlignment="Center"></Label>

            <!--Textbox for answer-->
            <TextBox x:Name="TxtAnswer" FontSize="25" MaxWidth="75" Padding="2" Margin="10"></TextBox>

            <!--Button for submitting answer-->
            <Button x:Name="BtnSubmit" Content="Submit" FontSize="25" MaxWidth="150" Click="BtnSubmit_Click"></Button>

            <!--Correct or false?-->
            <Label x:Name="LblFeedback" 
                   FontSize="25" 
                   HorizontalAlignment="Center"></Label>


        </StackPanel>
    </Grid>
</Window>
