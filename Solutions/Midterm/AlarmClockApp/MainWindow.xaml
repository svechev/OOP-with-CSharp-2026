<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlarmClockApp"
        xmlns:ClockLib="clr-namespace:ClockLib;assembly=ClockLib" x:Class="AlarmClockApp.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="800">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <!--Left stack panel-->
        <StackPanel>
            <ClockLib:DigitalClock ClockStarted="DigitalClock_ClockStarted" TimeUpdated="DigitalClock_TimeUpdated"/>
            <Button x:Name="btnDistinct" Content="Find Distinct Numbers" MinHeight="25" Margin="5" Click="btnDistinct_Click"></Button>
            <TextBox x:Name="txtDisplayStart" Height="150" VerticalScrollBarVisibility="Visible"></TextBox>
            
        </StackPanel>

        <!--Right stack panel-->
        <StackPanel Grid.Column="1" Margin="5">
            <!--Grid for top-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Ring after[min]:" Grid.Column="0" VerticalAlignment="Center"></TextBlock>
                <TextBox x:Name="txtRingAfter" Grid.Column="1" MinHeight="20" Width="35" HorizontalAlignment="Left" TextWrapping="Wrap" AcceptsReturn="True">
                    <!--<TextBox.Text>
                        <Binding ElementName="slrRing" Path="Value" StringFormat="F2" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <local:RingValidator MinRings="0" MaxRings="5"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>-->
                </TextBox>
            </Grid>
            
            <!--Slider-->
            <Slider x:Name="slrRing" Minimum="0" Maximum="5" TickPlacement="BottomRight"></Slider>
            
            <!--Bottom part-->
            <TextBlock x:Name="blockBeepIndicator" Text="Beep Indicator:"></TextBlock>
            <TextBox x:Name="txtBeepIndicator" MinHeight="260" VerticalScrollBarVisibility="Visible"></TextBox>
            
            
        </StackPanel>
    </Grid>
</Window>
