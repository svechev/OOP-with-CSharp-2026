<Window x:Class="Zadacha2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zadacha2"
        mc:Ignorable="d"
        Title="Dependency Slider TextBox" Height="290" Width="547">
    <Window.Resources>
        <local:ValueConvertor x:Key="ValueConverterKey"/>
        <Style   TargetType="TextBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="14,0,14,0"/>
        </Style>
        <Style   TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="14,0,14,0"/>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Label Content="Bind with XAML"  />
        <!--<TextBox x:Name="txtBindWithXaml" Style="{DynamicResource TxtStyle}"
                 Text="{Binding ElementName=slrSlider, Path=Value, 
                                UpdateSourceTrigger=PropertyChanged,
                                Converter={StaticResource ValueConverterKey}}" />-->
        <TextBox x:Name="txtBindWithXaml"  
                 Text="{Binding ElementName=slrSlider, Path=Value, 
                                UpdateSourceTrigger=PropertyChanged,
                                Converter={StaticResource ValueConverterKey}}" />
        <Label Content="Bind with Code"  />
        <TextBox x:Name="txtBindWithCode"    Text="0.00"/>
        <Slider x:Name="slrSlider" TickPlacement="TopLeft" Maximum="100" Margin="14,0,14,0"/>
    </StackPanel>
</Window>
