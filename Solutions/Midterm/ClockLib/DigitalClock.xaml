<UserControl x:Class="ClockLib.DigitalClock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClockLib"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="300" Background="Azure">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <!--Textbox for clock-->
            <TextBox x:Name="txtDigital" Text="00:00:00"></TextBox>
            
            <!--Grid for buttons-->
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Button x:Name="btnStart" Content="Start" Grid.Column="0" Grid.Row="0" Click="btnStart_Click"/>
                <Button x:Name="btnStop" Content="Stop" Grid.Column="2" Grid.Row="0" Click="btnStop_Click"/>
                <Button x:Name="btnReset" Content="Reset" Grid.Column="1" Grid.Row="1" Click="btnReset_Click"/>

            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
