<UserControl x:Class="TradeServices.OrderProduct"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TradeServices"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="350" Background="White">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="MinWidth" Value="50"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </UserControl.Resources>
    
    <StackPanel Margin="15">
        
        <!--product-->
        <StackPanel Margin="5" Orientation="Horizontal">
            <Label Content="Product"></Label>
            <ComboBox x:Name="cboProduct"></ComboBox>
        </StackPanel>
        
        <!--quantity-->
        <StackPanel Margin="5" Orientation="Horizontal">
            <Label Content="Quantity"></Label>
            <TextBox x:Name="txtQty" Text="0"></TextBox>
        </StackPanel>

        <StackPanel Margin="5" Orientation="Horizontal">
            <Button x:Name="btnOrder" Content="Order" Click="btnOrder_Click"></Button>
            <Button x:Name="btnCancel" Click="btnCancel_Click" Content="Cancel"></Button>
        </StackPanel>
    </StackPanel>
</UserControl>
