<UserControl x:Class="SomeUserControl.SomeUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SomeUserControl"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="200" Background="White">
    <Grid>
        <StackPanel>
            <Label Content="Label text" FontSize="20" HorizontalAlignment="Center"/>
            <TextBox x:Name="someTxt" Padding="2" Width="150" Height="25"/>
        </StackPanel>

    </Grid>
</UserControl>
